# Arkand Care — Apache / LiteSpeed config for shared hosting (Hostinger, cPanel)
# Ignored by hosts that don't use Apache (e.g. Vercel) — harmless there.

# Custom error page
ErrorDocument 404 /404.html

# ---- Canonical host & scheme redirects ------------------------------------
# One canonical origin: https + non-www. Also strip /index.html to /.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (respect proxy header on LiteSpeed/Hostinger).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html (root or trailing) -> /
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteRule ^(.+)/index\.html$ /$1/ [L,R=301]
</IfModule>

# ---- Caching --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Fonts & images rarely change — cache hard.
  ExpiresByType font/woff2   "access plus 1 year"
  ExpiresByType image/jpeg   "access plus 1 year"
  ExpiresByType image/png    "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # CSS/JS: a week, so a re-upload reaches visitors quickly.
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  # HTML always revalidates so content updates show immediately.
  ExpiresByType text/html    "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compression (Brotli where available, else gzip) ----------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>
